# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-random-flask-secret-key

# LLM Provider (Groq, OpenRouter, OpenAI, etc.)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=openai/gpt-oss-120b

# Sarvam AI Voice & Speech API
SARVAM_CLONE_API_KEY=your-sarvam-clone-api-key
SARVAM_TTS_API_KEY=your-sarvam-tts-api-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MOCK=0
DAILY_TTS_CHAR_CAP=2000

# Database path (on Vercel serverless, leaves blank or defaults to /tmp/persona_chat.db)
DATABASE_PATH=persona_chat.db

